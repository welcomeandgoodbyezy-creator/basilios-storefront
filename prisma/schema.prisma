datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Reservation {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  date      String
  time      String
  guests    String
  occasion  String?
  notes     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservations")
}